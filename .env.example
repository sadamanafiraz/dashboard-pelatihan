# Gunakan pooled connection string Neon untuk aplikasi Vercel.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Opsional tetapi sangat disarankan. Digunakan untuk upload dan edit catatan.
ADMIN_UPLOAD_KEY=ganti-dengan-kunci-yang-panjang-dan-acak
